{
  "hosting": {
    "target": "nimlo-updates",
    "public": "public",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]},
      {"source": "/nimlo-updates.json", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, max-age=0"}]},
      {"source": "/stable/latest.json", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, max-age=0"}, {"key": "Content-Type", "value": "application/json; charset=utf-8"}]},
      {"source": "/stable/Nimlo-*.zip", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}, {"key": "Content-Type", "value": "application/zip"}]}
    ]
  }
}
